{
  "name": "pi-config",
  "version": "0.1.0",
  "private": true,
  "description": "Team settings and extensions for the pi coding agent, tuned for GitHub Copilot",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "workspaces": [
    "relay"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "relay": "node relay/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.test.ts",
    "validate-skills": "uv run --quiet scripts/validate.py",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate-skills",
    "check-prices": "node scripts/prices.mjs check",
    "price-table": "node scripts/prices.mjs table"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "@xterm/headless": "5.5.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
