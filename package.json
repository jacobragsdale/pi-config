{
  "name": "pi-config",
  "version": "0.1.0",
  "private": true,
  "description": "Team settings and extensions for the pi coding agent, tuned for GitHub Copilot",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.test.ts",
    "check-prices": "node scripts/prices.mjs check",
    "price-table": "node scripts/prices.mjs table"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typebox": "1.3.27",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
